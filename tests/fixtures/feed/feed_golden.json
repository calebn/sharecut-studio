        "kind": "edit",
        "edit": {
          "op": "unset",
          "key": "item.title"
        }
      },
      "expect": {
        "item": {
          "item.title": {
            "value": "Nobody asked the river",
            "source": {
              "kind": "derived",
              "rule": "the project name"
            }
          }
        },
        "file": "current"
      }
    },
    {
      "name": "unsetting a key the view does not know changes nothing",
