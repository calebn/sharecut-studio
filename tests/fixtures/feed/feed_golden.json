  "cases": [
    {
      "name": "setting the title pins it and stales the file",
      "view": "ready",
      "fix": {
        "kind": "edit",
        "edit": {
          "op": "set",
          "key": "item.title",
          "value": "New name"
        }
      },
      "expect": {
        "item": {
          "item.title": {
            "value": "New name",
            "source": {
              "kind": "pinned",
              "by": "person",
              "drifted": false
            }
          }
        },
        "file": "stale",
        "findings": [],
        "itemXmlIncludes": ["<title>New name</title>"]
      }
    },
    {
      "name": "setting a pending intro fills it, clears its warning and reaches the notes",
      "view": "pending",
      "fix": {
        "kind": "edit",
        "edit": {
          "op": "set",
          "key": "item.intro",
          "value": "Why the river moved."
        }
      },
      "expect": {
        "item": {
          "item.intro": {
            "value": "Why the river moved.",
            "source": {
              "kind": "pinned",
              "by": "person",
              "drifted": false
            }
          }
        },
        "findings": [
          {
            "key": "item.enclosure.url",
            "severity": "blocker"
          }
        ],
        "file": "none",
        "notesHtmlIncludes": ["<p>Why the river moved.</p>"]
      }
    },
    {
      "name": "setting the hosting address clears the blocker and adds the enclosure",
      "view": "pending",
      "fix": {
        "kind": "edit",
        "edit": {
          "op": "set",
          "key": "item.enclosure.url",
          "value": "https://cdn.example.test/a.mp3"
        }
      },
      "expect": {
        "findings": [
          {
            "key": "item.intro",
            "severity": "warn"
          }
        ],
        "itemXmlIncludes": [
          "<enclosure url=\"https://cdn.example.test/a.mp3\" length=\"1000\" type=\"audio/mpeg\"/>"
        ]
      }
    },
    {
      "name": "setting an empty text is an unset",
      "view": "ready",
      "fix": {
        "kind": "edit",
        "edit": {
          "op": "set",
          "key": "item.intro",
          "value": ""
        }
      },
      "expect": {
        "item": {
          "item.intro": {
            "value": null,
            "source": {
              "kind": "pending",
              "why": "Say what this episode is about.",
              "fix": {
                "kind": "input",
                "key": "item.intro"
              }
            }
          }
        },
        "findings": [
          {
            "key": "item.intro",
            "severity": "warn"
          }
        ],
        "file": "stale"
      }
    },
    {
      "name": "unsetting a pinned title falls back to the derived one",
      "view": "ready",
      "fix": {
        "kind": "edit",
        "edit": {
          "op": "set",
          "key": "item.title",
          "value": "Other"
        }
      },
      "then": {
        "kind": "edit",
        "edit": {
          "op": "unset",
          "key": "item.title"
        }
      },
      "expect": {
        "item": {
          "item.title": {
            "value": "Nobody asked the river",
            "source": {
              "kind": "derived",
              "rule": "the project name"
            }
          }
        },
        "itemXmlIncludes": ["<title>Nobody asked the river</title>"]
      }
    },
    {
      "name": "unsetting a key that holds no pin changes nothing",
