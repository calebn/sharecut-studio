#!/bin/sh
# Block push unless local make ci is green for HEAD (or SKIP_CI=1).
# Red make ci → non-zero exit → Git aborts the push (pack is never sent).
set -e
cd "$(git rev-parse --show-toplevel)"
export PATH="$PWD/.venv/bin:$PWD/gui/web/node_modules/.bin:$PATH"

if [ "${SKIP_CI:-}" = "1" ]; then
  echo "pre-push: SKIP_CI=1 — skipping make ci" >&2
  exit 0
fi

head_sha="$(git rev-parse HEAD)"
zero="0000000000000000000000000000000000000000"
has_non_delete=0
mismatch=0

while read -r _local_ref local_sha _remote_ref _remote_sha
do
  case "$local_sha" in
    ''|"$zero") ;;
    *)
      has_non_delete=1
      if [ "$local_sha" != "$head_sha" ]; then
        echo "pre-push: refusing tip $local_sha (checkout HEAD is $head_sha)" >&2
        echo "pre-push: check out the tip you are pushing, or push HEAD only" >&2
        mismatch=1
      fi
      ;;
  esac
done

if [ "$has_non_delete" -eq 0 ]; then
  exit 0
fi

if [ "$mismatch" -eq 1 ]; then
  exit 1
fi

if ! git diff-index --quiet HEAD --; then
  echo "pre-push: worktree is dirty — commit or stash before push" >&2
  echo "pre-push: ci-stamp must attest a clean HEAD (not uncommitted fixes)" >&2
  exit 1
fi

stamp_file="$(git rev-parse --git-dir)/ci-stamp"
if [ -f "$stamp_file" ] && [ "$(cat "$stamp_file")" = "$head_sha" ]; then
  echo "pre-push: ci-stamp matches HEAD — skipping make ci" >&2
  exit 0
fi

echo "pre-push: running make ci (gate; red aborts push)…" >&2
# Git sets GIT_DIR for hooks; pytest git fixtures must discover their own repos.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
make ci
