#!/bin/sh
# Format staged Ruff/Biome files via lint-staged, then run check-only pre-commit hooks.
set -e
cd "$(git rev-parse --show-toplevel)"

# Fresh worktrees have no .venv / node_modules yet: provision instead of failing.
if [ ! -x .venv/bin/python ] || [ ! -x gui/web/node_modules/.bin/lint-staged ]; then
  echo "pre-commit: provisioning this checkout (make worktree-setup)…" >&2
  sh scripts/worktree-setup.sh
fi

export PATH="$PWD/.venv/bin:$PWD/gui/web/node_modules/.bin:$PATH"

lint-staged --config lint-staged.config.mjs

if [ -x .venv/bin/pre-commit ]; then
  .venv/bin/pre-commit run --hook-stage pre-commit --color always
elif command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage pre-commit --color always
elif command -v uvx >/dev/null 2>&1; then
  uvx pre-commit run --hook-stage pre-commit --color always
else
  echo "pre-commit: neither pre-commit nor uvx found; skipping check-only hooks (ux-pack-sync, schema, capabilities, cheatsheet)." >&2
fi
