          "src/podcast_mcp/mcp/server.py",
          "src/podcast_mcp/clips/",
          "src/podcast_mcp/services/clip.py"
        ],
        "exclude": [
          "src/podcast_mcp/mcp/tools/guest/"
        ]
      }
    },
