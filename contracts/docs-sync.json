{
  "api_version": 1,
  "description": "Docs-sync map: the source of truth for AGENTS.md § Docs in sync (regenerate the table with `make docs-sync-table`). A rule fires when a changed path matches its gate/advisory trigger; it is satisfied when some other changed path matches one of its `docs` globs. `gate` rules fail `docs_sync.py check` in CI; `advisory` rules (including every row with no trigger yet) only report. Waive with the commit trailer `Docs-Sync-Waive: <id> <reason>`.",
  "ignore": [
    "**/*.test.*",
    "**/*.stories.*",
    "uv.lock",
    "gui/web/package-lock.json",
    "tests/"
  ],
  "rules": [
    {
      "id": "layers-packages-or-service-boundaries",
      "when": "Layers, packages, or service boundaries",
      "update": "`docs/architecture.md`",
      "docs": [
        "docs/architecture.md"
      ],
      "advisory": {
        "include": [
          "src/podcast_mcp/*/__init__.py",
          "src/podcast_mcp/**/__init__.py"
        ]
      }
    },
    {
      "id": "source-timeline-timebase-sessiontimeline-or",
      "when": "Source/timeline timebase, `SessionTimeline`, or clip time math",
      "update": "`docs/episode-format-v2.md`, `docs/architecture.md` § Timebase, `docs/contributing.md` § Time handling, `docs/testing.md`, `util/tool_timebase.py` (`TOOL_TIMEBASE`), affected skills (`podcast-play-audition`, `podcast-chapter-markers`, `podcast-edit-natural-language`, `podcast-social-clips`, `podcast-mute-bleed`)",
      "docs": [
        "docs/episode-format-v2.md",
        "docs/architecture.md",
        "docs/contributing.md",
        "docs/testing.md",
        "src/podcast_mcp/util/tool_timebase.py"
      ],
      "advisory": {
        "include": [
          "src/podcast_mcp/util/timebase.py",
          "src/podcast_mcp/util/tool_timebase.py",
          "src/podcast_mcp/engines/session_timeline.py",
          "src/podcast_mcp/engines/timemap.py",
          "src/podcast_mcp/engines/session_clock.py",
          "src/podcast_mcp/edits/timeline_span.py",
          "src/podcast_mcp/edits/transcript_sync.py",
          "gui/web/src/utils/timebase.ts"
        ]
      }
    },
    {
      "id": "setup-commands-or-repo-layout",
      "when": "Setup, commands, or repo layout",
      "update": "`README.md`, `docs/setup.md`",
      "docs": [
        "README.md",
        "docs/setup.md"
      ],
      "advisory": {
        "include": [
          "Makefile",
          "install.sh",
          "scripts/worktree-setup.sh",
          ".githooks/pre-commit",
          ".nvmrc",
          "src/podcast_mcp/cli/main.py"
        ]
      }
    },
    {
      "id": "python-deps",
      "when": "Python dependencies (add/remove/bump)",
      "update": "`pyproject.toml`, then regenerate `uv.lock` (`uv lock`), `docs/setup.md`",
      "docs": [
        "pyproject.toml",
        "uv.lock",
        "docs/setup.md"
      ],
      "advisory": {
        "include": [
          "pyproject.toml"
        ]
      }
    },
    {
      "id": "contributor-workflow",
      "when": "Contributor workflow",
      "update": "`docs/contributing.md`, this file",
      "docs": [
        "docs/contributing.md"
      ],
      "advisory": null
    },
    {
      "id": "mcp-tools-or-nl-social-workflows",
      "when": "MCP tools or NL/social workflows",
      "update": "`docs/nl-editing.md`, `docs/transcript-workflow.md`, `docs/social-clips.md`, `docs/timeline-comments.md`, relevant `.agents/skills/` (incl. `podcast-transcript-workflow`, `podcast-play-audition`, `podcast-timeline-comments`)",
      "docs": [
        "docs/nl-editing.md",
        "docs/transcript-workflow.md",
        "docs/social-clips.md",
        "docs/timeline-comments.md",
        ".agents/skills/"
