{
  "$comment": "Which tracks a ripple moves, and what a trim leaves on each. gui/web/src/edit/ripplePreview.ts rippleTrackIds mirrors edits/ripple.ripple_track_ids, and its trim preview mirrors plan_trim + apply_trim_geometry. gui/web/src/edit/ripplePreview.test.ts and tests/test_ripple_scope_contract.py both read these cases. Clips are [id, timeline_start, source_start, source_end] with an optional source_id (the recording the clip plays; absent = the track's own media, and the clip's own recording length caps how far an edge grows); lanes after a trim are [timeline_start, timeline_end, source_start, source_end] in timeline order; arrows are [from, to] seconds, the preview's downstream moves; cuts are the span a lane loses.",
  "scope_cases": [
    {
      "name": "every dialogue track in project order",
      "tracks": [{ "id": "guest", "role": "dialogue" }, { "id": "music", "role": "music" }, { "id": "host", "role": "dialogue" }],
      "edited": [],
      "scope": ["guest", "host"]
    },
    {
      "name": "an edited non-dialogue track joins after them",
      "tracks": [{ "id": "guest", "role": "dialogue" }, { "id": "music", "role": "music" }, { "id": "host", "role": "dialogue" }],
      "edited": ["music"],
      "scope": ["guest", "host", "music"]
    },
    {
      "name": "an edited dialogue track adds nothing",
      "tracks": [{ "id": "guest", "role": "dialogue" }, { "id": "music", "role": "music" }, { "id": "host", "role": "dialogue" }],
      "edited": ["host", "host"],
      "scope": ["guest", "host"]
    },
    {
      "name": "an unknown edited track is ignored",
      "tracks": [{ "id": "guest", "role": "dialogue" }, { "id": "sfx", "role": "sfx" }],
      "edited": ["ghost", "sfx"],
      "scope": ["guest", "sfx"]
    },
    {
      "name": "a muted dialogue track still ripples",
      "tracks": [{ "id": "host", "role": "dialogue", "muted": true }, { "id": "intro", "role": "intro" }, { "id": "guest", "role": "dialogue" }],
      "edited": [],
      "scope": ["host", "guest"]
    }
  ],
  "trim_tracks": [
    { "id": "host", "role": "dialogue", "duration_sec": 60 },
    { "id": "guest", "role": "dialogue", "duration_sec": 60 },
