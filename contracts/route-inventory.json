      "path": "/r/{token}/mcp"
    },
    {
      "gate": "public",
      "handler": "podcast_mcp.gui.server:create_app.<locals>.record_spa",
      "method": "GET",
      "path": "/rec/{token}",
      "reason": "record SPA shell; the token only picks the page head"
    },
    {
      "gate": "public",
      "handler": "fastapi.applications:FastAPI.setup.<locals>.redoc_html",
      "method": "GET",
      "path": "/redoc",
      "reason": "FastAPI interactive docs"
    }
  ]
}
