{
  "name": "web",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-app.ts",
    "lint": "oxlint && npm run lint:css",
    "lint:css": "stylelint \"{src,public}/**/*.css\"",
    "typecheck": "tsc -b --pretty false",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cheatsheet": "vite-node scripts/generate-keymap-cheatsheet.ts",
    "cheatsheet:check": "vite-node scripts/generate-keymap-cheatsheet.ts --check",
    "test:e2e": "vite-node scripts/run-e2e.ts",
    "test:e2e:compat": "vite-node scripts/run-e2e.ts --config=playwright.compat.config.ts",
    "test:e2e:install": "playwright install chromium webkit firefox",
    "test:e2e:storybook": "playwright test --config=playwright.storybook.config.ts",
    "profile:remaining": "vite-node scripts/profile-remaining.ts",
    "profile:compare": "vite-node scripts/profile-compare.ts",
    "profile:summary": "vite-node scripts/profile-summary.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.0.10",
    "@babel/traverse": "8.0.10",
    "@babel/types": "8.0.10",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "storybook": "^10.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-no-px": "^2.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
