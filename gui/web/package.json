{
  "name": "web",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run lint:css",
    "lint:css": "stylelint \"{src,public}/**/*.css\"",
    "typecheck": "tsc -b --pretty false",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cheatsheet": "vite-node scripts/generate-keymap-cheatsheet.ts",
    "cheatsheet:check": "vite-node scripts/generate-keymap-cheatsheet.ts --check",
    "test:e2e": "vite-node scripts/run-e2e.ts",
    "test:e2e:compat": "vite-node scripts/run-e2e.ts --config=playwright.compat.config.ts",
    "test:e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-no-px": "^2.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
