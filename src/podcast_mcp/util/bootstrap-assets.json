{
  "$schema": "./bootstrap-assets.schema.json",
  "version": 1,
  "cdn_base_env": "PODCAST_BOOTSTRAP_CDN_BASE",
  "cdn_base_default": null,
  "assets": {
    "whisper-base": {
      "kind": "huggingface",
      "repo": "Systran/faster-whisper-base",
      "revision": "main",
      "license": "MIT",
      "cdn_prefix": "models/whisper-base",
      "notes": "Pin to a commit SHA before shipping consumer builds; keep LICENSE in the mirror."
    },
    "whisper-large-v3-turbo": {
      "kind": "huggingface",
      "repo": "Systran/faster-whisper-large-v3-turbo",
      "revision": "main",
      "license": "MIT",
      "cdn_prefix": "models/whisper-large-v3-turbo",
      "notes": "Product default; pin revision + per-file sha256 in funnel mirror before consumer SLA."
    },
    "rnnoise": {
      "kind": "http",
      "url": "https://raw.githubusercontent.com/GregorR/rnnoise-models/master/somnolent-hogwash-2018-09-01/sh.rnnn",
      "revision_note": "Prefer a commit-pinned raw URL before production mirror",
      "license": "BSD-style (RNNoise)",
      "cdn_prefix": "models/rnnoise",
      "filename": "somnolent-hogwash.rnnn"
    }
  },
  "fallback": {
    "whisper": "huggingface_hub / faster-whisper default download",
    "rnnoise": "GitHub raw URL via util.model_assets"
  }
}
