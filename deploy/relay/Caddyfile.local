:8080 {
	@relay path /healthz /llms.txt /tunnel /r/* /rec/* /api* /mcp* /auth*
	handle @relay {
		reverse_proxy podcast-relay:8081
	}

	respond "Not Found" 404

	log {
		format filter {
			wrap console
			fields {
				request>uri regexp ^(https?://[^/?]+)?(?:(/r/|/rec/|/mcp/|/api/review/|/api/rec/|/api/mcp/|/api/reports/bundles/|/api/reports/)[^/?]*((?:/[^?]*)?)(?:\?.*)?|((?:/api/relay/notice/continue/?|/r|/rec|/mcp|/api/review|/api/rec|/api/mcp|/api/reports/bundles|/api/reports)\?).*|(/)[^?]*%.*|(/auth[^?]*\?).*|(/[^?]*\?)[^/%]*[/%].*) $1$2$4$5$6$7-REDACTED$3
				request>headers>Referer regexp ^(https?://[^/?#]+)?(?:(/r/|/rec/|/mcp/|/api/review/|/api/rec/|/api/mcp/|/api/reports/bundles/|/api/reports/)[^/?#]*((?:/[^?#]*)?)(?:[?#].*)?|((?:/api/relay/notice/continue/?|/r|/rec|/mcp|/api/review|/api/rec|/api/mcp|/api/reports/bundles|/api/reports)\?).*|(/)[^?#]*%.*|(/auth[^?#]*[?#]).*|(/[^?#]*[?#])[^/%]*[/%].*) $1$2$4$5$6$7-REDACTED$3
				resp_headers>Location regexp ^(https?://[^/?#]+)?(?:(/r/|/rec/|/mcp/|/api/review/|/api/rec/|/api/mcp/|/api/reports/bundles/|/api/reports/)[^/?#]*((?:/[^?#]*)?)(?:[?#].*)?|((?:/api/relay/notice/continue/?|/r|/rec|/mcp|/api/review|/api/rec|/api/mcp|/api/reports/bundles|/api/reports)\?).*|(/)[^?#]*%.*|(/auth[^?#]*[?#]).*|(/[^?#]*[?#])[^/%]*[/%].*) $1$2$4$5$6$7-REDACTED$3
			}
		}
	}
}
