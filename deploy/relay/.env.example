# Local development only — copy to .env, then run `docker compose up --build`.
# This file does not configure a production deployment.

# Comma-separated host device tokens for local testing.
PODCAST_RELAY_HOST_TOKENS=dev-host-token

# Local/dev only: allow tunnels when PODCAST_RELAY_HOST_TOKENS is empty.
# Never set to 1 in production.
# PODCAST_RELAY_ALLOW_OPEN_TUNNEL=0

# Rate limits (generous defaults; set PODCAST_RELAY_RATE_LIMIT=0 to disable).
# PODCAST_RELAY_RATE_LIMIT=1
# PODCAST_RELAY_TOKEN_RPM=600
# PODCAST_RELAY_TOKEN_BURST=80
# PODCAST_RELAY_IP_RPM=1200
# PODCAST_RELAY_IP_BURST=120
# PODCAST_RELAY_TOKEN_CONCURRENT=24
# PODCAST_RELAY_HOST_CONCURRENT=96
# PODCAST_RELAY_AUDIO_CONCURRENT=8
# PODCAST_RELAY_REGISTER_RPM=60
# PODCAST_RELAY_REGISTER_BURST=20
# PODCAST_RELAY_MAX_BODY_BYTES=4194304
# PODCAST_RELAY_WS_MAX_SIZE=16777216

# Production: set these through your deployment's secret/configuration system.
# RELAY_DOMAIN=relay.example.com
# RELAY_IMAGE=registry.example.com/your-org/podcast-relay:version
# PODCAST_RELAY_HOST_TOKENS=<a comma-separated set of generated secrets, each 32+ chars>
# Production rejects the local dev token and token values shorter than 32 characters.
