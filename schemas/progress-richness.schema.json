{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharecut.studio/schemas/progress-richness.schema.json",
  "title": "Progress richness registry",
  "type": "object",
  "required": ["api_version", "rich"],
  "additionalProperties": false,
  "properties": {
    "api_version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "rich": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
